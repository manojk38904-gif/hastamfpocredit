rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function staffDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isStaff() { return signedIn() && exists(staffDoc()) && get(staffDoc()).data.active == true; }
    function isAdmin() { return isStaff() && get(staffDoc()).data.role == 'admin'; }
    function setupPath() { return /databases/$(database)/documents/config/setup; }

    match /config/{id} {
      allow read: if true;
      allow create: if signedIn() && id == 'setup' && !exists(setupPath());
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /users/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'admin'
            && !exists(setupPath()) && existsAfter(setupPath()));
      allow update, delete: if isAdmin();
    }
    match /secrets/{uid} {
      allow read, write: if isAdmin();
    }
    match /apps/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isStaff()
        || (signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'draft');
      allow update: if isStaff()
        || (signedIn() && resource.data.ownerUid == request.auth.uid && resource.data.status == 'draft'
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.status in ['draft', 'submitted']);
    }
    match /files/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isStaff() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }
    match /entries/{id} {
      allow read, write: if isStaff();
    }
    match /meta/{id} {
      allow read, write: if signedIn();
    }
  }
}
